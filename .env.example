# GitHub Personal Access Token (required for higher rate limits)
# Create one at: https://github.com/settings/tokens
# Permissions needed: public_repo (for public repositories)
GITHUB_TOKEN=your_github_token_here
# .env file - GitHub API Configuration

# Set your Hugging Face token (get it from https://huggingface.co/settings/tokens)
HF_TOKEN=your_hugging_face_token

# Azure OpenAI Configuration (for chat completions)
AZURE_OPENAI_API_KEY=your_openai_api_key
AZURE_OPENAI_ENDPOINT=https://<your-openai-endpoint>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=al-gpt-5
AZURE_OPENAI_API_VERSION=2024-08-01-preview
